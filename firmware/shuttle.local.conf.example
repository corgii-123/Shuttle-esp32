# Copy to shuttle.local.conf (git-ignored) and fill in. sdkconfig syntax: strings in quotes.
# Everything here can also be set via `idf.py menuconfig` -> Component config -> Shuttle (搞快).
CONFIG_SHUTTLE_SERVER_URL="wss://shuttle.example.com"
CONFIG_SHUTTLE_TOKEN="change-me-to-a-long-random-string"

# Wi-Fi list in priority order. Phones are found automatically on every network (the board
# scans for adbd on :5555; the Mac recognises each phone and picks one), so PHONE_HOST stays
# empty. Optional: PHONE_HOST="<ip>" = only that phone on this network, "none" = no ADB here.
# All Wi-Fi must be 2.4 GHz (the ESP32-S3 has no 5 GHz).
# SERVER_URL per network (optional): where the Mac is on the same LAN, e.g. at home, talk to it
# directly ("ws://<mac-lan-ip>:8780") instead of out to the Internet and back through the tunnel.

# Priority 1: home Wi-Fi (phones on the router)
CONFIG_SHUTTLE_WIFI1_SSID="HomeWiFi"
CONFIG_SHUTTLE_WIFI1_PASSWORD="home-password"
CONFIG_SHUTTLE_WIFI1_PHONE_HOST=""
# CONFIG_SHUTTLE_WIFI1_SERVER_URL="ws://192.168.1.7:8780"   # the Mac is on this LAN (server.host: 0.0.0.0)

# Priority 2: the phone's hotspot (when out)
CONFIG_SHUTTLE_WIFI2_SSID="MyPhoneHotspot"
CONFIG_SHUTTLE_WIFI2_PASSWORD="hotspot-password"
CONFIG_SHUTTLE_WIFI2_PHONE_HOST=""

# Optional: a third network (office...)
# CONFIG_SHUTTLE_WIFI3_SSID="Office"
# CONFIG_SHUTTLE_WIFI3_PASSWORD="..."

# Optional tuning
# CONFIG_SHUTTLE_WIFI_ROAM_INTERVAL_S=300   # hotspot -> home auto switch check (doubles up to 1 h)
# CONFIG_SHUTTLE_SKIP_OTA_CHECK=y
# CONFIG_SHUTTLE_ADB_RX_BUFFER_KB=256
# CONFIG_SHUTTLE_PHONE_SCAN_INTERVAL_S=300  # look for new phones while one is in use (0 = only when none is)
# CONFIG_SHUTTLE_PHONE_SCAN_TIMEOUT_MS=700  # raise if a sleeping phone is missed

# Development only (leave off in use)
# CONFIG_SHUTTLE_DEBUG_CONSOLE=y        # USB command console: ptt/tap/dump/stats (tools/esp_console.py --fifo)
# CONFIG_SHUTTLE_DEBUG_SCREEN_DUMP=y    # log every e-paper frame (tools/screen_dump.py)
